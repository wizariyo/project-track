# Database configuration
# To use SQLite (local development), leave this empty.
# To connect to Supabase PostgreSQL (production), paste your connection string below.
# Example format: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# JWT token signature secret (recommended to change in production)
JWT_SECRET=projecttrack-super-secret-key-987654321
