rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function signedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if signedIn();
      // Allow signup (creating new user document)
      allow create: if signedIn() && isOwner(userId);
      // Allow updating their own profile, or if the requester is a teacher
      allow update: if signedIn() && (isOwner(userId) || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher');
      allow delete: if signedIn() && isOwner(userId);
    }

    // Groups Collection
    match /groups/{groupId} {
      allow read: if signedIn();
      // Only teachers and group members should be able to create/update groups
      allow create, update, delete: if signedIn();
    }

    // Tasks Collection
    match /tasks/{taskId} {
      allow read, write: if signedIn();
    }

    // Comments Collection
    match /comments/{commentId} {
      allow read, write: if signedIn();
    }

    // Subtasks Collection
    match /subtasks/{subtaskId} {
      allow read, write: if signedIn();
    }

    // Reports Collection
    match /reports/{reportId} {
      allow read, write: if signedIn();
    }

    // Files Collection
    match /files/{fileId} {
      allow read, write: if signedIn();
    }

    // Chats Collection
    match /chats/{chatId} {
      allow read, write: if signedIn();
      
      // Messages Subcollection inside Chats
      match /messages/{messageId} {
        allow read, write: if signedIn();
      }
    }

    // Milestones Collection
    match /milestones/{milestoneId} {
      allow read, write: if signedIn();
    }

    // Peer Evaluations Collection
    match /peerEvaluations/{evalId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
    }
  }
}
