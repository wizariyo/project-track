rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isTeacher() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && isOwner(userId);
      allow update: if signedIn() && (isOwner(userId) || isTeacher());
      allow delete: if signedIn() && isOwner(userId);
    }

    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (isTeacher() || resource.data.groupLeadId == request.auth.uid || resource.data.teacherId == request.auth.uid);
    }

    match /tasks/{taskId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
    }

    match /comments/{commentId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && resource.data.author.id == request.auth.uid;
    }

    match /subtasks/{subtaskId} {
      allow read, write: if signedIn();
    }

    match /reports/{reportId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn() && (resource.data.submittedBy == request.auth.uid || isTeacher());
    }

    match /files/{fileId} {
      allow read, write: if signedIn();
    }

    match /chats/{chatId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if signedIn();
      
      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn();
        allow update, delete: if signedIn() && resource.data.senderId == request.auth.uid;
      }
    }

    match /milestones/{milestoneId} {
      allow read, write: if signedIn();
    }

    match /peerEvaluations/{evalId} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.resource.data.fromUserId == request.auth.uid;
    }
  }
}
